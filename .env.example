# Configure locally in .env.local and in Vercel Project Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Public anon/publishable key — OK in the browser. Must NOT be able to read PII
# or member_roster (RLS + revoked grants). Only intentional public tables (e.g. committee).
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY

# Server-only — never expose to the browser (no NEXT_PUBLIC_ prefix). Full DB access
# for admin APIs / imports. Keep only in Vercel server env + local .env.local.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
AUTH_SECRET=GENERATE_WITH_openssl_rand_base64_32

# Public site URL used in password-reset emails (optional locally; Vercel sets VERCEL_URL).
# Use the live Vercel URL until sfs.alumnicorner.org DNS is ready.
NEXT_PUBLIC_APP_URL=https://sfs-alumni-golden-jubilee-alpha.vercel.app

# Resend (https://resend.com) — password reset emails. Without these, links are logged in dev only.
RESEND_API_KEY=
EMAIL_FROM="SFS Alumni <admin@alumnicorner.org>"

# Cashfree Payment Gateway (Dashboard → Developers → API Keys). sandbox | production
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Optional: NEXT_PUBLIC_CASHFREE_MODE only affects SDK mode fallback; committee toggle is in Admin → Bank / UPI.
# Webhook URL in Cashfree dashboard: https://<host>/api/payments/webhook
# Apply migration 20261115120000_payment_checkout_settings.sql — default online checkout off until admin enables it.

# Event gate volunteers (shared PIN for /gate scanner only — not full admin).
GATE_PIN=1234

# Web push (npx web-push generate-vapid-keys). Required for admin Broadcast.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alumni@sfsshanthinagar.edu

# Optional day-of copy overrides for /event-app/day
# NEXT_PUBLIC_EVENT_DAY_HEADLINE=
# NEXT_PUBLIC_EVENT_DAY_WHEN=
# NEXT_PUBLIC_EVENT_DAY_VENUE=
# NEXT_PUBLIC_EVENT_DAY_MAP_URL=
# NEXT_PUBLIC_EVENT_DAY_PARKING=
# NEXT_PUBLIC_EVENT_DAY_HELP=
# NEXT_PUBLIC_EVENT_DAY_HELP_PHONE=
